// Prisma schema for HelloDesk Phase 1

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model WorkspaceTier {
  id               String   @id @default(uuid())
  key              String   @unique // "basic", "pro", "advance"
  name             String   // "Basic (Free)", "Pro", "Advance"
  tokenLimit       Int      @map("token_limit") // 50,000 (5%), 100,000 (10%), 200,000 (20%)
  tokenPercent     Int      @map("token_percent") // 5, 10, 20
  maxCustomModels  Int      @map("max_custom_models") // 3, 5, 10
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  workspaces Workspace[]

  @@map("workspace_tiers")
}

model Workspace {
  id                 String   @id @default(uuid())
  name               String   @unique
  shortName          String?  @map("short_name")
  logoUrl            String?  @map("logo_url")
  isActive           Boolean  @default(true) @map("is_active")
  theme              Json?    @default("{\"primaryColor\":\"#2563eb\",\"primaryHover\":\"#1d4ed8\",\"accentColor\":\"#4f46e5\",\"bgColor\":\"#f8fafc\",\"cardBg\":\"#ffffff\"}")
  aiEnabled          Boolean  @default(true) @map("ai_enabled")
  tierKey            String   @default("basic") @map("tier_key")
  freeTierTokensUsed Int      @default(0) @map("free_tier_tokens_used")
  freeTierResetAt    DateTime? @map("free_tier_reset_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  workspaceTier WorkspaceTier @relation(fields: [tierKey], references: [key], onDelete: Restrict)
  users         User[]
  contacts      Contact[]
  conversations Conversation[]
  articles      Article[]
  categories    ArticleCategory[]
  customDomain  CustomDomain?
  llmModels     LlmModel[]
  defaultPermissions WorkspaceDefaultPermission[]
  llmLogs            LlmRequestLog[]

  @@map("workspaces")
}

model Role {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions    RolePermission[]
  workspaceDefaults WorkspaceDefaultPermission[]
  userPermissions   UserPermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model WorkspaceDefaultPermission {
  workspaceId  String   @map("workspace_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([workspaceId, permissionId])
  @@map("workspace_default_permissions")
}

model UserPermission {
  userId       String   @map("user_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

model User {
  id           String   @id @default(uuid())
  workspaceId  String   @map("workspace_id")
  roleId       String   @map("role_id")
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  workspace             Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role                  Role             @relation(fields: [roleId], references: [id])
  userPermissions       UserPermission[]
  assignedConversations Conversation[]   @relation("AssignedAgent")
  messages              Message[]

  @@index([workspaceId])
  @@map("users")
}

model Contact {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  visitorId   String?  @unique @map("visitor_id")
  email       String?
  name        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([workspaceId, email])
  @@map("contacts")
}

enum ConversationChannel {
  chat
  email
}

enum ConversationStatus {
  open
  pending
  snoozed
  resolved
}

model Conversation {
  id            String              @id @default(uuid())
  workspaceId   String              @map("workspace_id")
  contactId     String              @map("contact_id")
  assigneeId    String?             @map("assignee_id")
  channel       ConversationChannel
  status        ConversationStatus  @default(open)
  lastMessageId String?             @map("last_message_id")
  aiSummary     String?             @map("ai_summary")
  aiSummaryAt   DateTime?           @map("ai_summary_at")
  snoozedUntil  DateTime?           @map("snoozed_until")
  rating        Int?
  ratingFeedback String?            @map("rating_feedback")
  ratedAt       DateTime?           @map("rated_at")
  tokensUsed    Int                 @default(0) @map("tokens_used")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignee  User?     @relation("AssignedAgent", fields: [assigneeId], references: [id])
  messages  Message[]
  llmLogs   LlmRequestLog[]

  @@index([workspaceId, status])
  @@index([workspaceId, assigneeId])
  @@map("conversations")
}

enum MessageSenderType {
  contact
  agent
  system
}

model Message {
  id             String            @id @default(uuid())
  conversationId String            @map("conversation_id")
  senderType     MessageSenderType @map("sender_type")
  senderUserId   String?           @map("sender_user_id")
  body           String
  attachments    Json?
  mediaType      String?           @map("media_type")
  emailMessageId String?           @map("email_message_id")
  emailInReplyTo String?           @map("email_in_reply_to")
  isInternalNote Boolean           @default(false) @map("is_internal_note")
  isAiDraft      Boolean           @default(false) @map("is_ai_draft")
  readAt         DateTime?         @map("read_at")
  createdAt      DateTime          @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser   User?        @relation(fields: [senderUserId], references: [id])

  @@index([conversationId])
  @@map("messages")
}

enum ArticleStatus {
  draft
  published
}

model ArticleCategory {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  name        String
  slug        String
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  articles  Article[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@map("article_categories")
}

model Article {
  id          String        @id @default(uuid())
  workspaceId String        @map("workspace_id")
  categoryId  String?       @map("category_id")
  title       String
  slug        String
  content     String
  status      ArticleStatus @default(draft)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  ArticleCategory? @relation(fields: [categoryId], references: [id])

  @@unique([workspaceId, slug])
  @@index([workspaceId, status])
  @@map("articles")
}

enum DomainVerificationStatus {
  pending
  verified
  failed
}

model CustomDomain {
  id                 String                   @id @default(uuid())
  workspaceId        String                   @unique @map("workspace_id")
  domain             String                   @unique
  verificationStatus DomainVerificationStatus @default(pending) @map("verification_status")
  verificationToken  String                   @map("verification_token")
  sslIssuedAt        DateTime?                @map("ssl_issued_at")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("custom_domains")
}

model LlmModel {
  id               String    @id @default(uuid())
  workspaceId      String    @map("workspace_id")
  provider         String    // "google", "openai", "anthropic"
  modelName        String    @map("model_name")
  apiKey           String    @map("api_key")
  isDefault        Boolean   @default(false) @map("is_default")
  status           String    @default("unverified") // "verified", "unverified", "invalid_key", "rate_limited"
  rateLimitResetAt DateTime? @map("rate_limit_reset_at")
  totalTokensUsed  Int       @default(0) @map("total_tokens_used")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("llm_models")
}

model LlmRequestLog {
  id             String   @id @default(uuid())
  workspaceId    String   @map("workspace_id")
  conversationId String?  @map("conversation_id")
  provider       String
  modelName      String   @map("model_name")
  taskType       String   @map("task_type") // "summary", "draft"
  promptTokens   Int      @default(0) @map("prompt_tokens")
  responseTokens Int      @default(0) @map("response_tokens")
  totalTokens    Int      @default(0) @map("total_tokens")
  latencyMs      Int      @map("latency_ms")
  status         String   // "success", "failed", "rate_limited", "invalid_key"
  errorMessage   String?  @map("error_message")
  createdAt      DateTime @default(now()) @map("created_at")

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([conversationId])
  @@map("llm_request_logs")
}
